# ── Stage 1: Node binary ────────────────────────────────────────
# Pulled from an already-built image instead of node:20-slim — one fewer base
# image to fetch/vendor for the closed network. Point ASSETS_SOURCE_IMAGE at
# any image with a working /usr/local/bin/node (any prior build of this same
# Dockerfile qualifies). No such image on a truly first build?
# --build-arg ASSETS_SOURCE_IMAGE=node:20-slim falls back to the network pull.
ARG ASSETS_SOURCE_IMAGE=rag-assistant-offline:latest
FROM ${ASSETS_SOURCE_IMAGE} AS node-source

# ── Stage 2: Final image ────────────────────────────────────────
# Retrieval + API + MCP + Web UI. The LLM lives in its own image
# (Dockerfile.llm) so it can be replaced by a corporate endpoint.
FROM python:3.11-slim

# zstd for the offline bundle
RUN apt-get update && apt-get install -y zstd && rm -rf /var/lib/apt/lists/*

# Node binary (stable)
COPY --from=node-source /usr/local/bin/node /usr/local/bin/node

# ── Python deps (cached: only invalidated when requirements.txt changes) ──
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
COPY --from=wheels . /tmp/wheels
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --find-links=/tmp/wheels -r /app/backend/requirements.txt

# Fastembed cache (stable)
COPY --from=fastembed-cache . /root/.cache/fastembed
ENV FASTEMBED_CACHE_PATH=/root/.cache/fastembed
ENV HF_HUB_OFFLINE=1

# ── e5 query:/passage: prefixes ──────────────────────────────────
# Must match the value used by rag-generation when the database was built:
# documents indexed with "passage: " are only searchable by queries embedded
# with "query: ". A mismatch silently degrades results - nothing errors out.
# Off by default (measured slightly worse on the small starting corpus).
# ENV RAG_EMBED_E5_PREFIXES=1

# ── Application code ────────────────────────────────────────────
COPY backend /app/backend

WORKDIR /app/web
COPY --from=next-standalone . ./
COPY --from=next-public . ./public
COPY --from=next-static . ./.next/static

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

WORKDIR /app

# LLM connector defaults — override to point at the sibling llm service or a
# corporate endpoint (see docker-compose.yml).
ENV LLM_BASE_URL=http://llm:9080
ENV LLM_MODEL_NAME=qwen2.5
ENV NODE_ENV=production

EXPOSE 8000 9081 3000

CMD ["/app/entrypoint.sh"]
